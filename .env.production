# ===== App =====
NODE_ENV=production
PORT=3000
CLIENT_URL=https://shopspace.com

# ===== MongoDB =====
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopspace_prod

# ===== JWT =====
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# ===== Bcrypt =====
BCRYPT_SALT_ROUNDS=12

# ===== OTP =====
OTP_LENGTH=6
OTP_EXPIRES_IN_MINUTES=10

# ===== Nodemailer (Gmail SMTP) =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_prod_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="ShopSpace <no-reply@shopspace.com>"

# ===== Google OAuth =====
GOOGLE_CLIENT_ID="981265190649-1qc49qhtuaen6mk3vquh5hbdvvom7u19.apps.googleusercontent.com"


# ===== Rate limiting =====
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=5
